# Next.js / Auth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# PostgreSQL (shared by Next.js and FastAPI)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/optimus
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/optimus

# News providers
NEWS_API_KEY=
GUARDIAN_API_KEY=
# GNews (optional — falls back to free RSS feeds if not set)
GNEWS_API_KEY=

# LLM Provider — choose one: gemini | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Embeddings (Gemini text-embedding-004 by default, zero extra keys)
EMBEDDING_MODEL=text-embedding-004
VECTOR_SIMILARITY_THRESHOLD=0.70

# LangGraph FastAPI service
AGENT_BACKEND_URL=http://localhost:8000
AGENT_SERVICE_TOKEN=

# Redis
REDIS_URL=redis://localhost:6379/0

# Rule Engine thresholds (tune to taste)
RULE_ENGINE_CRITICAL_THRESHOLD=9.0
RULE_ENGINE_HIGH_THRESHOLD=7.5
RULE_ENGINE_MEDIUM_THRESHOLD=5.0

# Rule Engine weights (must sum to 1.0)
WEIGHT_BUSINESS_IMPACT=0.30
WEIGHT_URGENCY=0.25
WEIGHT_MARKET_IMPACT=0.20
WEIGHT_NOVELTY=0.15
WEIGHT_CONFIDENCE=0.10

# Confidence routing
LOW_CONFIDENCE_THRESHOLD=0.60
CRITICAL_MIN_SOURCE_RELIABILITY=0.75
CRITICAL_MIN_CONFIDENCE=0.80

# Source reliability DB cache TTL (seconds)
SOURCE_RELIABILITY_CACHE_TTL_SECONDS=300

# Notifications — Slack
SLACK_WEBHOOK_URL=

# Notifications — Microsoft Teams
TEAMS_WEBHOOK_URL=

# Notifications — Email
NOTIFICATION_EMAIL_TO=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Legacy email (backward compat)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Background jobs (ARQ + Redis)
ARQ_REDIS_URL=
SCHEDULED_ANALYSIS_CRON=
# Comma-separated queries for scheduled analysis
DEFAULT_ANALYSIS_QUERIES=

# Playwright scraping (opt-in)
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_MAX_PAGES=10

# LangSmith monitoring (opt-in)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=optimus-news-intelligence
LANGSMITH_TRACING_ENABLED=false
